# The server's environment: copy to /opt/ticket-tracker/.env on the VPS (chmod 600, owned by the deploy user).
# It never leaves the server and is never in the repository; the pipeline does not touch it.

# --- HTTPS (Caddy)
# The name that points at the VPS (DNS A/AAAA record). With no domain, <ip with dashes>.sslip.io works, e.g. 203-0-113-10.sslip.io
DOMAIN=tickets.example.com
ACME_EMAIL=you@example.com

# --- application
APP_ENV=production
PUBLIC_URL=https://tickets.example.com
# Caddy is the one reverse proxy in front of the application.
TRUST_PROXY=1
# 48+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# The RUNTIME role through the Supabase session pooler (IPv4), never the migrator's URL.
DATABASE_URL=postgresql://app_runtime.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=support&sslmode=require&connection_limit=5
# Supabase's CA as PEM text; in a .env file keep the double quotes and the \n between the lines.
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_BUCKET=ticket-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_CONCURRENT_UPLOADS=4
# Optional AI field help: set AI_ENABLED=true and the key to switch it on (a restart is needed); leave off otherwise.
# The limits are 10 questions per person per minute, a 10 second wait and 200 requests a day for everyone (AI_* in the README).
AI_ENABLED=false
ANTHROPIC_API_KEY=
