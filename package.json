{
  "name": "@berney/support-ticket-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "com.berney Support Ticket Tracker: AdminJS + Express + Prisma + Supabase",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:reference": "tsx --env-file-if-exists=.env src/cli/seed-reference.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/cli/seed-demo.ts",
    "seed:verify": "tsx --env-file-if-exists=.env src/cli/seed-verify.ts",
    "seed:reset": "tsx --env-file-if-exists=.env src/cli/seed-reset.ts",
    "admin:create": "tsx --env-file-if-exists=.env src/cli/admin-create.ts",
    "db:provision": "tsx --env-file-if-exists=.env src/cli/db-provision.ts",
    "storage:reconcile": "tsx --env-file-if-exists=.env src/cli/storage-reconcile.ts",
    "storage:check": "tsx --env-file-if-exists=.env src/cli/storage-check.ts"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/prisma": "5.0.4",
    "@adminjs/themes": "1.0.1",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@prisma/client": "6.19.3",
    "adminjs": "7.8.17",
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "express": "4.21.2",
    "express-formidable": "1.2.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.18.1",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "prisma": "6.19.3",
    "tslib": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
