{
  "name": "@berney/support-ticket-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "com.berney Support Ticket Tracker: AdminJS + Express + Prisma + Supabase",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests tests/unit tests/integration",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:reference": "tsx scripts/seed-reference.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:verify": "tsx scripts/seed-verify.ts",
    "seed:reset": "tsx scripts/seed-reset.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "storage:reconcile": "tsx scripts/storage-reconcile.ts"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/prisma": "5.0.4",
    "@prisma/client": "6.19.3",
    "adminjs": "7.8.17",
    "express": "4.21.2",
    "express-formidable": "1.2.0",
    "express-session": "1.18.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.5",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
