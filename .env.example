# APP_ENV: development | demo | production
APP_ENV=development
PORT=3000
# Public base URL (used for Origin check)
PUBLIC_URL=http://localhost:3000
# Number of reverse proxies to trust (0 for local dev)
TRUST_PROXY=0

# Supabase PostgreSQL (schema "support"). Runtime role: minimal privileges, no DDL.
DATABASE_URL=postgresql://runtime_user:CHANGE_ME@localhost:5432/postgres?schema=support
# Migration credentials: only for the migration stage
DIRECT_URL=postgresql://migrator:CHANGE_ME@localhost:5432/postgres?schema=support
# Supabase requires TLS. node-postgres verifies the server certificate against the system roots, which do not contain
# Supabase's own CA: paste its PEM text here (Settings > Database > SSL certificate; line breaks as \n) so the session
# store can connect with verification. Prisma takes its TLS settings from the URL above.
# In a .env file wrap the value in double quotes, otherwise Node stops reading it at the first \n:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----\n"

# Sessions
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_AT_LEAST_32_CHARACTERS
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Login throttling (in-memory counters: single replica only)
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_IP=20
LOGIN_MAX_FAILED_PER_ACCOUNT=5

# Sign-in with Google and/or GitHub (optional). A provider is on when both of its values are set.
# It opens only accounts that already exist (matched by the provider's verified e-mail); nothing is created.
# Callback addresses to register: <PUBLIC_URL>/auth/oauth/google/callback and <PUBLIC_URL>/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase Storage (S3-compatible), private bucket "ticket-attachments".
# Leave these empty in development to keep attachments in memory (lost on restart).
# All four are required in production and demo.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ticket-attachments
# Uploads processed at once; memory use is bounded by this x 10 MiB
MAX_CONCURRENT_UPLOADS=4

# Seed (never commit real values)
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
ALLOW_DEMO_RESET=false

# Optional AI field help (requirements section 12). Off by default.
AI_ENABLED=false
# Needed when AI_ENABLED=true (never commit a real key). Leave empty otherwise.
ANTHROPIC_API_KEY=
# The model, the thinking effort (low, medium or high), and the limits: questions per person per minute, the longest
# wait in milliseconds, the longest reply in tokens (the model's reasoning counts too) and requests per day for everyone.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# AI_RATE_PER_MINUTE=10
# AI_TIMEOUT_MS=10000
# AI_MAX_OUTPUT_TOKENS=1024
# AI_DAILY_REQUESTS=200
# AI_PROVIDER=fake answers from the field catalog without calling anyone: development and tests only, refused in production.
