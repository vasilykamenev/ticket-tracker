# APP_ENV: development | demo | production
APP_ENV=development
PORT=3000
# Public base URL (used for Origin check)
PUBLIC_URL=http://localhost:3000
# Number of reverse proxies to trust (0 for local dev)
TRUST_PROXY=0

# Supabase PostgreSQL (schema "support"). Runtime role: minimal privileges, no DDL.
DATABASE_URL=postgresql://runtime_user:CHANGE_ME@localhost:5432/postgres?schema=support
# Migration credentials: only for the migration stage
DIRECT_URL=postgresql://migrator:CHANGE_ME@localhost:5432/postgres?schema=support

# Sessions
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_AT_LEAST_32_CHARACTERS
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Login throttling (in-memory counters: single replica only)
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_PER_IP=20
LOGIN_MAX_FAILED_PER_ACCOUNT=5

# Supabase Storage (S3-compatible), private bucket
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=ticket-attachments

# Seed (never commit real values)
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
ALLOW_DEMO_RESET=false

# Optional AI bonus
AI_ENABLED=false
